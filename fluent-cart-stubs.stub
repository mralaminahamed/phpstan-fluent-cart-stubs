namespace FluentCart\App\Models\BatchQuery {
    interface BatchInterface
    {
        /**
         * Update multiple rows.
         *
         * @param \FluentCart\Framework\Database\Orm\Model $table
         * @param array $values
         * @param string|null $index
         * @param bool $raw
         * @return mixed
         */
